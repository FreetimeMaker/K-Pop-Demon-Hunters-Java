<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:theme="@style/ThemeOverlay.KPopDemonHunters.FullscreenContainer"
    tools:context=".ui.music.ZoeyMusicActivity">

    <!-- This FrameLayout insets its children based on system windows using
         android:fitsSystemWindows. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/fullscreen_content_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            tools:ignore="UselessParent">

            <!-- Scrollable content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Title -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/zoeyMusicTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        android:textSize="30sp"
                        android:text="Songs Featuring Zoey"
                        android:textColor="@color/black"
                        android:paddingBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/hidImage"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:src="@drawable/hid"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/hidBackTXT"
                            android:layout_width="125dp"
                            android:layout_height="wrap_content"
                            android:text="How It’s Done"
                            android:textAlignment="center"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/HIDInfoButton"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="Get More Infos about the Song" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/zoeyImage"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:src="@drawable/zoey"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/zoeyBackTXT"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Go Back to the Infos about Zoey"
                            android:textAlignment="center"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/BackToZoeyInfoButton"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="Go Back to the Infos about Zoey" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>