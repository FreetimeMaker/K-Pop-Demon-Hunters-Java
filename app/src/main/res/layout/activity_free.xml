<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:theme="@style/ThemeOverlay.KPopDemonHunters.FullscreenContainer"
    tools:context=".ui.music.FreeActivity">

    <!-- This FrameLayout insets its children based on system windows using
         android:fitsSystemWindows. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/fullscreen_content_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:text="Get more Infos about the Song Free"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginTop="8dp"
                android:text="Title: Free"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:text="Artists: Rumi (HUNTR/X), Jinu (Saja Boys), EJAE, Andrew Choi"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:text="Album: K-Pop Demon Hunters (Soundtrack from the Netflix Film / Deluxe Version)"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:text="Released: June 20, 2025"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:text="Language: English-Korean"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:text="Label: Netflix Music, JYP Entertainment, Republic Records, Universal Music Group"/>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:text="Producers: Jenna Andrews, Stephen Kirk, Ian Eisendrath"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textAlignment="center"
                        android:layout_marginTop="12dp"
                        android:text="Songwriters: Jenna Andrews, Stephen Kirk, Mark Sonnenblick"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textAlignment="center"
                        android:layout_marginTop="12dp"
                        android:text="Lyrics and Meanings: The song opens with Rumi's verse: 'I tried to hide but something broke / I tried to sing, couldn't hit the notes...' These lines reflect her internal struggle - a metaphor for her dual life as an idol and demon hunter. The chorus builds into a declaration of trust and emotional release: 'Why does it feel right every time I let you in?' The lyrics explore the tension between danger and connection, hinting at Rumi's fear of her own powers and her need for someone who accepts her fully."/>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textAlignment="center"
                        android:layout_marginTop="12dp"
                        android:text="In the Film: 'Free'plays during a pivotal moment when Rumi confronts her demon heritage and opens up to her teammates. It's both a character anthem and a turning point in the story, showcasing her vulnerability and strength."/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/BackToMFButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:text="Go Back to the Songs that"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>